{
  "ci": {
    "collect": {
      "staticDistDir": "./dist",
      "numberOfRuns": 2
    },
    "assert": {
      "assertions": {
        "categories:performance": ["error", { "minScore": 0.95 }],
        "categories:accessibility": ["error", { "minScore": 1.0 }],
        "categories:best-practices": ["error", { "minScore": 1.0 }],
        "categories:pwa": ["error", { "minScore": 1.0 }]
      }
    }
  }
}
